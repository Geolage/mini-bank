generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  OPERATOR
  CHECKER
}

enum AccountType {
  CHECKING
  SAVINGS
}

enum Currency {
  USD
  HKD
  CNY
}

enum TransactionStatus {
  COMPLETED
  FAILED
}

enum TransferOrderStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id            String          @id @default(uuid())
  username      String          @unique
  email         String          @unique
  passwordHash  String          @map("password_hash")
  name          String
  role          Role            @default(VIEWER)
  accounts      Account[]
  payees        Payee[]
  auditLogs     AuditLog[]      @relation("ActorAuditLogs")
  makerOrders   TransferOrder[] @relation("MakerTransferOrders")
  checkerOrders TransferOrder[] @relation("CheckerTransferOrders")
  createdAt     DateTime        @default(now()) @map("created_at")

  @@map("users")
}

model Account {
  id             String          @id @default(uuid())
  userId         String          @map("user_id")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountNumber  String          @unique @map("account_number")
  type           AccountType
  currency       Currency        @default(USD)
  balance        Decimal         @db.Decimal(14, 2)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  outgoing       Transaction[]   @relation("FromAccount")
  incoming       Transaction[]   @relation("ToAccount")
  outgoingOrders TransferOrder[] @relation("FromAccountOrders")
  incomingOrders TransferOrder[] @relation("ToAccountOrders")

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id             String            @id @default(uuid())
  reference      String            @unique
  fromAccountId  String            @map("from_account_id")
  fromAccount    Account           @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccountId    String            @map("to_account_id")
  toAccount      Account           @relation("ToAccount", fields: [toAccountId], references: [id])
  amount         Decimal           @db.Decimal(14, 2)
  currency       Currency
  status         TransactionStatus @default(COMPLETED)
  idempotencyKey String            @unique @map("idempotency_key")
  note           String?
  createdAt      DateTime          @default(now()) @map("created_at")
  order          TransferOrder?

  @@index([fromAccountId, createdAt(sort: Desc)])
  @@index([toAccountId, createdAt(sort: Desc)])
  @@map("transactions")
}

model TransferOrder {
  id             String              @id @default(uuid())
  reference      String              @unique
  idempotencyKey String              @unique @map("idempotency_key")
  makerId        String              @map("maker_id")
  maker          User                @relation("MakerTransferOrders", fields: [makerId], references: [id])
  checkerId      String?             @map("checker_id")
  checker        User?               @relation("CheckerTransferOrders", fields: [checkerId], references: [id])
  fromAccountId  String              @map("from_account_id")
  fromAccount    Account             @relation("FromAccountOrders", fields: [fromAccountId], references: [id])
  toAccountId    String              @map("to_account_id")
  toAccount      Account             @relation("ToAccountOrders", fields: [toAccountId], references: [id])
  amount         Decimal             @db.Decimal(14, 2)
  currency       Currency
  note           String?
  status         TransferOrderStatus @default(PENDING)
  decisionNote   String?             @map("decision_note")
  decidedAt      DateTime?           @map("decided_at")
  transactionId  String?             @unique @map("transaction_id")
  transaction    Transaction?        @relation(fields: [transactionId], references: [id])
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([status, createdAt(sort: Desc)])
  @@index([makerId, createdAt(sort: Desc)])
  @@map("transfer_orders")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String   @map("actor_id")
  actor        User     @relation("ActorAuditLogs", fields: [actorId], references: [id])
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model Payee {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  accountNumber String   @map("account_number")
  bankName      String   @default("MiniBank") @map("bank_name")
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([userId, accountNumber])
  @@index([userId])
  @@map("payees")
}
