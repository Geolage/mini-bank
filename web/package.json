{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "author": "Geolage Wu",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "size": "node scripts/check-bundle-size.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:clean": "node -e \"const { rmSync } = require('node:fs'); for (const p of ['cypress/screenshots', 'cypress/videos', 'cypress/downloads']) rmSync(p, { recursive: true, force: true })\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@ant-design/pro-components": "2.8.10",
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "@tanstack/react-query": "5.105.0",
    "antd": "5.29.3",
    "dayjs": "1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "cypress": "^16.2.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.1"
  }
}
